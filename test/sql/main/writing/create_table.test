# name: test/sql/main/writing/create_table.test
# description: CREATE TABLE for delta tables
# group: [writing]

require parquet

require delta

require notwindows

# -----------------------------------------------------------------------------
# Basic create
#

statement ok
ATTACH '{TEMP_DIR}/delta_create_basic' AS basic (TYPE delta);

statement ok
CREATE TABLE basic.basic (i INTEGER, s VARCHAR);

query I
SELECT count(*) FROM glob('{TEMP_DIR}/delta_create_basic/_delta_log/*.json');
----
1

# The new table is served from the catalog without re-attaching
query II
SELECT column_name, data_type FROM duckdb_columns() WHERE table_name = 'basic';
----
i	INTEGER
s	VARCHAR

query I
SELECT count(*) FROM basic.basic;
----
0

statement error
CREATE TABLE basic.basic (i INTEGER);
----
already exists

# A created table can be written and reopened through the normal catalog path.
statement ok
INSERT INTO basic.basic VALUES (1, 'one'), (2, 'two');

statement ok
DETACH basic;

statement ok
ATTACH '{TEMP_DIR}/delta_create_basic' AS basic_reopened (TYPE delta);

query II
SELECT * FROM basic_reopened.basic_reopened ORDER BY i;
----
1	one
2	two

statement ok
DETACH basic_reopened;

# -----------------------------------------------------------------------------
# Naming the destination
#

statement ok
ATTACH '{TEMP_DIR}/delta_create_with_path' AS with_path (TYPE delta);

statement ok
CREATE TABLE with_path.with_path (i INTEGER) WITH (path = '{TEMP_DIR}/delta_create_with_path');

query I
SELECT count(*) FROM with_path.with_path;
----
0

statement ok
ATTACH '{TEMP_DIR}/delta_create_other_path' AS other_path (TYPE delta);

statement error
CREATE TABLE other_path.other_path (i INTEGER) WITH (path = '{TEMP_DIR}/somewhere_else');
----
can only create a table at the attached path

# A trailing slash names the same path -- the comparison is normalized
statement ok
ATTACH '{TEMP_DIR}/delta_create_norm' AS norm (TYPE delta);

statement ok
CREATE TABLE norm.norm (i INTEGER) WITH (path = '{TEMP_DIR}/delta_create_norm/');

query I
SELECT count(*) FROM norm.norm;
----
0

statement error
CREATE TABLE norm.norm (i INTEGER) WITH (ignored_option = 'value');
----
does not support option 'ignored_option'

# -----------------------------------------------------------------------------
# CREATE conflict handling
#

statement ok
ATTACH '{TEMP_DIR}/delta_create_conflict' AS conflict (TYPE delta);

statement ok
CREATE TABLE conflict.conflict (i INTEGER);

# IF NOT EXISTS on an existing table is a no-op, and must not write a second commit
statement ok
CREATE TABLE IF NOT EXISTS conflict.conflict (i INTEGER);

query I
SELECT count(*) FROM glob('{TEMP_DIR}/delta_create_conflict/_delta_log/*.json');
----
1

statement error
CREATE OR REPLACE TABLE conflict.conflict (i INTEGER);
----
do not support CREATE OR REPLACE TABLE

# IF NOT EXISTS on a fresh path still creates
statement ok
ATTACH '{TEMP_DIR}/delta_create_if_not_exists' AS ine (TYPE delta);

statement ok
CREATE TABLE IF NOT EXISTS ine.ine (i INTEGER);

query I
SELECT count(*) FROM ine.ine;
----
0

# -----------------------------------------------------------------------------
# Partition columns
#

statement ok
ATTACH '{TEMP_DIR}/delta_create_partitioned' AS partitioned (TYPE delta);

statement ok
CREATE TABLE partitioned.partitioned (id INTEGER, part_col VARCHAR) PARTITIONED BY (part_col);

query I
SELECT count(*) FROM partitioned.partitioned;
----
0

statement ok
INSERT INTO partitioned.partitioned VALUES (1, 'eu'), (2, 'eu');

statement ok
DETACH partitioned;

statement ok
ATTACH '{TEMP_DIR}/delta_create_partitioned' AS partitioned_reopened (TYPE delta);

query II
SELECT * FROM partitioned_reopened.partitioned_reopened ORDER BY id;
----
1	eu
2	eu

# DuckDB identifiers are case-insensitive, but kernel schema validation is case-sensitive.
statement ok
ATTACH '{TEMP_DIR}/delta_create_mixed_case' AS "MiXeD" (TYPE delta);

statement ok
CREATE TABLE mixed.mixed (id INTEGER, "Part" VARCHAR) PARTITIONED BY (part);

statement ok
INSERT INTO mixed.mixed VALUES (1, 'eu');

query II
SELECT * FROM mixed.mixed;
----
1	eu

# The scan must decode URI-encoded add paths without decoding the table root.
statement ok
ATTACH '{TEMP_DIR}/delta path #hash %percent apostrophe''s' AS special_path (TYPE delta);

statement ok
CREATE TABLE special_path.special_path (id INTEGER);

statement ok
INSERT INTO special_path.special_path VALUES (42);

statement ok
DETACH special_path;

query I
SELECT * FROM delta_scan('{TEMP_DIR}/delta path #hash %percent apostrophe''s');
----
42

# Relative add paths are decoded after they are classified.
statement ok
COPY (SELECT 43 AS id) TO '{TEMP_DIR}/delta path #hash %percent apostrophe''s/encoded name.parquet' (FORMAT parquet);

# Absolute add paths must not be joined to the table root.
statement ok
COPY (SELECT 44 AS id) TO '{TEMP_DIR}/delta-absolute-add.parquet' (FORMAT parquet);

# Malformed percent text must not cause unsafe decoding.
statement ok
COPY (SELECT 45 AS id) TO '{TEMP_DIR}/delta path #hash %percent apostrophe''s/malformed%name.parquet' (FORMAT parquet);

statement ok
COPY (VALUES
    ('{"add":{"path":"%2Fencoded%20name.parquet","partitionValues":{},"size":0,"modificationTime":0,"dataChange":true}}'),
    ('{"add":{"path":"file://{WORKING_DIR}/{TEMP_DIR}/delta-absolute-add.parquet","partitionValues":{},"size":0,"modificationTime":0,"dataChange":true}}'),
    ('{"add":{"path":"malformed%name.parquet","partitionValues":{},"size":0,"modificationTime":0,"dataChange":true}}')
) TO '{TEMP_DIR}/delta path #hash %percent apostrophe''s/_delta_log/00000000000000000001.json'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

query I
SELECT id FROM delta_scan('{TEMP_DIR}/delta path #hash %percent apostrophe''s') WHERE id >= 43 ORDER BY id;
----
43
44
45

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE table_name = 'MiXeD' ORDER BY column_index;
----
id	INTEGER
Part	VARCHAR

# Kernel requires at least one non-partition column
statement ok
ATTACH '{TEMP_DIR}/delta_create_all_partitioned' AS all_partitioned (TYPE delta);

statement error
CREATE TABLE all_partitioned.all_partitioned (part_col VARCHAR) PARTITIONED BY (part_col);
----
<REGEX>:.*artition.*

# -----------------------------------------------------------------------------
# Unsupported for now
#

statement ok
ATTACH '{TEMP_DIR}/delta_create_unsupported' AS unsupported (TYPE delta);

statement error
CREATE TABLE unsupported.wrong_name (i INTEGER);
----
must use the attached name

statement error
CREATE TABLE unsupported.unsupported (i INTEGER NOT NULL);
----
does not support NOT NULL

statement error
CREATE TABLE unsupported.unsupported (i UINTEGER);
----
does not support column 'i' of type UINTEGER

statement error
CREATE TABLE unsupported.unsupported (i INTEGER DEFAULT 42);
----
does not support DEFAULT for column 'i'

statement error
CREATE TABLE unsupported.unsupported (i INTEGER, doubled INTEGER GENERATED ALWAYS AS (i * 2));
----
does not support generated column 'doubled'

statement error
CREATE TABLE unsupported.unsupported (i INTEGER) SORTED BY (i);
----
SORTED BY is not supported for tables in a delta catalog

# Creation commits immediately. A surrounding DuckDB rollback does not remove the Delta commit.
statement ok
ATTACH '{TEMP_DIR}/delta_create_rollback' AS rollback_create (TYPE delta);

statement ok
BEGIN;

statement ok
CREATE TABLE rollback_create.rollback_create (i INTEGER);

statement ok
ROLLBACK;

statement ok
DETACH rollback_create;

statement ok
ATTACH '{TEMP_DIR}/delta_create_rollback' AS rollback_reopened (TYPE delta);

query I
SELECT count(*) FROM rollback_reopened.rollback_reopened;
----
0

# Kernel allows creation when _delta_log exists but contains no files.
statement ok
COPY (SELECT 1 AS p, 1 AS payload) TO '{TEMP_DIR}/delta_create_empty_log' (FORMAT parquet, PARTITION_BY (p));

statement ok
COPY (SELECT 1 AS p, 1 AS payload WHERE false) TO '{TEMP_DIR}/delta_create_empty_log/_delta_log' (FORMAT parquet, PARTITION_BY (p));

query I
SELECT count(*) FROM glob('{TEMP_DIR}/delta_create_empty_log/_delta_log/*');
----
0

statement ok
ATTACH '{TEMP_DIR}/delta_create_empty_log' AS empty_log (TYPE delta);

statement ok
CREATE TABLE empty_log.empty_log (i INTEGER);

query I
SELECT count(*) FROM empty_log.empty_log;
----
0

# Kernel treats a file anywhere below the log prefix as an existing table. Do not mistake a
# directory-only first level for an empty log.
statement ok
COPY (SELECT 1 AS p, 1 AS payload) TO '{TEMP_DIR}/delta_create_nested_log' (FORMAT parquet, PARTITION_BY (p));

statement ok
COPY (SELECT 1 AS p, 1 AS payload) TO '{TEMP_DIR}/delta_create_nested_log/_delta_log' (FORMAT parquet, PARTITION_BY (p));

statement ok
ATTACH '{TEMP_DIR}/delta_create_nested_log' AS nested_log (TYPE delta);

statement error
SHOW ALL TABLES;
----
<REGEX>:.*[Dd]elta.*

# name: test/sql/main/writing/delete/delete_read_only.test
# description: DELETE on READ_ONLY attached Delta table raises InvalidInputException
# group: [delete]

require parquet

require delta

require notwindows

# Create a writable table first
statement ok
ATTACH '__TEST_DIR__/delete_ro/tbl' AS tw (TYPE delta, allow_create true);

statement ok
CREATE TABLE tw.tw PARTITIONED BY (region) AS
SELECT * FROM (VALUES (1, 'east'), (2, 'west')) v(id, region);

statement ok
DETACH tw;

# Re-attach as READ_ONLY
statement ok
ATTACH '__TEST_DIR__/delete_ro/tbl' AS tro (TYPE delta, READ_ONLY);

statement error
DELETE FROM tro WHERE region = 'east';
----
Cannot delete from a read-only Delta table

statement ok
DETACH tro;

# name: test/sql/main/test_expression.test
# description: Test the get_delta_test_expression function
# group: [main]

require parquet

require delta

query I
SELECT count(*) FROM unnest(get_delta_test_expression())
----
52

# Check the v0.26 visitor callbacks that did not exist in the old expected output.
query I
SELECT count(*)
FROM unnest(get_delta_test_expression()) AS expressions(value)
WHERE value IN (
    'delta_kernel_map_to_struct(pv)',
    'COALESCE(col, 0)',
    'list_value(1, 2)'
)
----
3

# Struct-patch field order is not stable. Check its required metadata instead.
query IIII
SELECT
    count(*) FILTER (value LIKE 'delta_kernel_transform_expression%'),
    count(*) FILTER (value LIKE '%(kind = ''prepend'')%'),
    count(*) FILTER (value LIKE '%(kind = ''field'')%'),
    count(*) FILTER (value LIKE '%(kind = ''append'')%')
FROM unnest(get_delta_test_expression()) AS expressions(value)
----
3	1	1	1
